# ─── Sweet Delights Bakery — Server Environment ────────────────────────────
# Copy this file to .env and fill in your values.

# PostgreSQL connection string
# Local example:  postgresql://postgres:password@localhost:5432/sweet_delights
# Render / Supabase / Neon: paste the connection string from the dashboard
DATABASE_URL=xxxxx

# JSON Web Token secret — change this to a long random string in production
JWT_SECRET=xxxxxxx

# Admin credentials (used to seed the admin account on first run)
ADMIN_EMAIL=admin@sweetdelights.in
ADMIN_PASSWORD=admin123

# Port the Express server listens on
PORT=3001
